# Hostinger Apache rewrite rules for Express + Vite SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If an existing file or directory is requested, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite all requests (including /api/*) to index.html for client SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>
